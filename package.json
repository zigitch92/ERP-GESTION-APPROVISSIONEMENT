{
  "name": "cosider-h65-approvisionnement",
  "version": "1.0.0",
  "description": "Application de bureau de gestion des approvisionnements COSIDER H65.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop:dev": "concurrently -k -s first \"npm:dev\" \"wait-on tcp:3000 && electron .\"",
    "desktop:build": "npm run build && electron-builder --win nsis --x64",
    "desktop:portable": "npm run build && electron-builder --win zip --x64",
    "desktop:dir": "npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.4",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.cosider.h65.approvisionnement",
    "productName": "COSIDER H65 Approvisionnement",
    "electronLanguages": [
      "fr"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "COSIDER-H65-Approvisionnement-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "COSIDER H65 Approvisionnement"
    }
  }
}
